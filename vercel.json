{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    { "src": "/roundrobin-dbedit.php",   "dest": "/api/roundrobin-dbedit.php" },
    { "src": "/roundrobin-event.php",   "dest": "/api/roundrobin-event.php" },
    { "src": "/roundrobin-member.php",  "dest": "/api/roundrobin-member.php" },
    { "src": "/score/court",            "dest": "/api/score-court.php" },
    { "src": "/score-court-sample.php", "dest": "/api/score-court-sample.php" },
    { "src": "/score-court-sample2.php","dest": "/api/score-court-sample2.php" },
    { "src": "/display-sample.php",    "dest": "/api/display-sample.php" },
    { "src": "/display",               "dest": "/api/display.php" },
    { "src": "/guide",                 "dest": "/api/guide.php" },
    { "src": "/guide.php",             "dest": "/api/guide.php" },
    { "src": "/images/(.*)",           "dest": "/images/$1" },
    { "src": "/%E3%83%80%E3%82%A6%E3%83%B3%E3%83%AD%E3%83%BC%E3%83%89/(.*)", "dest": "/%E3%83%80%E3%82%A6%E3%83%B3%E3%83%AD%E3%83%BC%E3%83%89/$1" },
    { "src": "/(.*)", "dest": "/api/roundrobin.php" }
  ]
}
